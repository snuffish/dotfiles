{
  "env": {
    "CLAUDE_MEM_DISABLE_FILE_CONTEXT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(az repos *)",
      "mcp__codegraph__*",
      "Bash(grep:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Az devops invoke",
      "Bash(python3 -I .claude/skills/priis-local-env/scripts/db.py --yes *)",
      "Bash(python3 -I .claude/skills/priis-local-env/scripts/api.py *--yes*)",
      "Bash(python3 -I .claude/skills/priis-local-env/scripts/create_ticket.py *--yes*)",
      "Bash(python3 -I .claude/skills/priis-local-env/scripts/advance_ticket.py *--yes*)",
      "mcp__azure-devops__wit_work_item",
      "mcp__azure-devops__repo_pull_request",
      "mcp__azure-devops__repo_pull_request_thread"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/.cache/agent-artifacts"]
  },
  "model": "opus",
  "skillOverrides": {
    "find-skills": "off",
    "problem": "off",
    "refine": "off",
    "clean": "off",
    "modern-csharp": "off",
    "cs-backend-review": "off",
    "cs-frontend-review": "off",
    "cs-fullstack-review": "off",
    "cs-engineer-grill": "off",
    "code-documentation": "off",
    "create-ticket": "off",
    "e2e-testing-playwright-review": "off",
    "enhance-prompt": "off",
    "organize": "off",
    "squash-code-review": "off",
    "squash-ef-core-migrations": "off",
    "writing-skills": "off",
    "create-skill": "off",
    "crypto-com-app": "off",
    "no-worktrees": "off",
    "principles-interview": "off",
    "expressive": "off",
    "fix-findings": "off",
    "remember-this": "off",
    "pr-polish": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "dataviz": "off",
    "claude-api": "name-only",
    "claude-in-chrome": "name-only",
    "artifact-capabilities": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "update-config": "name-only",
    "loop": "off",
    "run": "off",
    "simplify": "name-only",
    "workflow-authoring": "name-only",
    "source-command-backend-migrate-to-tunit": "off",
    "source-command-backend-health-check": "off",
    "source-command-frontend-health-check": "off",
    "source-command-backend-release-notes": "off",
    "stitch-react-components": "off",
    "stitch::react-components": "off",
    "vercel-composition-patterns": "off",
    "vercel-react-best-practices": "off",
    "microsoft-foundry": "off",
    "claude-mem:babysit": "off",
    "claude-mem:handoff": "off",
    "claude-mem:backup-setup": "off",
    "claude-mem:build": "off",
    "claude-mem:build-and-release": "off",
    "claude-mem:ccs-align": "off",
    "claude-mem:childhood": "off",
    "claude-mem:design-is": "off",
    "claude-mem:do": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:make-plan": "off",
    "claude-mem:mode-creator": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:owner-goals": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:release": "off",
    "claude-mem:request-progress": "off",
    "claude-mem:screenpipe": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:timeline-report": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:weekly-digests": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "claude-mem-cowork:agent-cost-report": "off",
    "claude-mem-cowork:mem-search": "off",
    "mattpocock-skills:triage": "off",
    "mattpocock-skills:wayfinder": "off",
    "mattpocock-skills:wizard": "off",
    "mattpocock-skills:to-questionnaire": "off",
    "mattpocock-skills:wait-what": "off",
    "mattpocock-skills:handoff": "off",
    "claude-security:scan": "off",
    "priis-prod-diagnose": "off",
    "private-pr-review": "off",
    "schedule": "off",
    "skill-gap": "user-invocable-only",
    "skill-creator": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.terminal/claude/conflict-check.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.terminal/claude/skill-drift-warning.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.terminal/claude/session-lineage.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/Projects/cm-sync/cm_sync.py import --quiet || true",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.terminal/claude/quiet-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.terminal/claude/safety-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] || exit 0; case \"$(realpath \"$f\" 2>/dev/null || echo \"$f\")\" in \"$HOME\"/.terminal/skills/*.md) exit 0 ;; esac; npx prettier --write --ignore-unknown \"$f\""
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -f \"$f\" ] || exit 0; if m=$(grep -nE '^(<{7}( |$)|={7}$|>{7}( |$)|\\|{7}( |$))' \"$f\"); then printf 'Merge-conflict markers left in %s:\\n%s\\n' \"$f\" \"$m\" >&2; exit 2; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.terminal/claude/plan-lint.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); [ -n \"$f\" ] || exit 0; f=$(realpath -m \"$f\"); case \"$f\" in \"$HOME\"/.terminal/skills/*) out=$(sync-skills 2>&1) || { printf \"%s\\n\" \"$out\" | tail -20 >&2; exit 2; } ;; esac",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          },
          {
            "type": "command",
            "command": "python3 -I ~/.terminal/claude/session-lineage.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.terminal/claude/skill-help.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.terminal/claude/session-lineage.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I ~/Projects/cm-sync/cm_sync.py sync --quiet || true",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "engineering-advanced-skills@claude-code-skills": false,
    "engineering-skills@claude-code-skills": false,
    "tanstack-ai@tanstack-ai": false,
    "mattpocock-skills@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "cc-plugin-you-should-know@builtin": true,
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "retro@netresearch-claude-code-marketplace": true,
    "prompt-improver@severity1-marketplace": true,
    "cmem-pro@thedotmack": true,
    "code-simplifier@anthropic-plugin-directory": false
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    },
    "tanstack-ai": {
      "source": {
        "source": "github",
        "repo": "TanStack/ai"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "netresearch-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "netresearch/claude-code-marketplace"
      }
    },
    "severity1-marketplace": {
      "source": {
        "source": "github",
        "repo": "severity1/severity1-marketplace"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "qwen/qwen3.5-9b": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude-memory",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(dotnet build backend/GR.PRIIS.Backend.slnx:*)",
      "Bash(dotnet test backend/GR.PRIIS.Backend.slnx:*)",
      "Bash(dotnet format backend/GR.PRIIS.Backend.slnx:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run organize-imports:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(az repos pr update:*)",
      "Bash(az devops invoke:* --http-method POST*)",
      "Bash(az repos pr:* --status all)",
      "Bash(az devops invoke:* --http-method POST)"
    ]
  },
  "voiceEnabled": false
}
