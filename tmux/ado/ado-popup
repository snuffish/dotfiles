#!/usr/bin/env bash
# Opens the ADO overlay popup on client $1 at 80% of its size, centred on the screen.
# A helper so run-shell expands #{client_name} in the arguments.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec tmux display-popup -c "$1" -B -E -x C -y C -h 80% -w 80% "$here/ado-overlay.py"
