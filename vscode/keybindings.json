// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save",
  },
  {
    "key": "ctrl+f",
    "command": "actions.find",
    "when": "editorFocus || editorIsOpen",
  },
  {
    "key": "ctrl+f",
    "command": "-cursorRight",
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+f",
    "command": "-extension.vim_ctrl+f",
    "when": "editorTextFocus && vim.active && vim.use<C-f> && !inDebugRepl && vim.mode != 'Insert'",
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.new"
  },
  {
    "key": "escape escape",
    "command": "closeFindWidget",
    "when": "findWidgetVisible"
  },
  {
    "key": "escape escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus && !findWidgetVisible"
  },
  {
    "key": "shift+h",
    "command": "workbench.action.previousEditor",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+l",
    "command": "workbench.action.nextEditor",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z shift+h",
    "command": "workbench.action.closeEditorsToTheLeft",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z h",
    "command": "workbench.action.closeEditorsToTheLeft",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z shift+l",
    "command": "workbench.action.closeEditorsToTheRight",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z l",
    "command": "workbench.action.closeEditorsToTheRight",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z shift+q",
    "command": "workbench.action.closeOtherEditors",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "shift+z q",
    "command": "workbench.action.closeOtherEditors",
    "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && !inputFocus && !webviewFindWidgetFocused"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus"
  },
  {
    "key": "alt+q",
    "command": "antigravity.openAgent",
    "when": "antigravity.agentSidePanel.isFocused || focusedView == 'antigravity.agentSidePanel' || activePaneCompositeId == 'antigravity.agentViewContainerId'"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closeAuxiliaryBar",
    "when": "auxiliaryBarFocus"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closePanel",
    "when": "panelFocus || terminalFocus"
  }
]